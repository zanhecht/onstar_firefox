{
  "manifest_version": 2,
  "name": "OnStar Auth Token Saver",
  "version": "1.0.0",
  "description": "Captures OAuth auth codes from GM/OnStar login flow and saves them to a file.",
  "permissions": ["downloads", "storage", "tabs", "webRequest", "*://custlogin.gm.com/*"],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_action": {
    "default_title": "OnStar Auth Token Saver",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg",
      "48": "icons/icon.svg"
    }
  }
}
